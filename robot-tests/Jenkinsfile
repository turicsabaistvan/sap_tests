pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'ROBOT_INCLUDE', description: 'Robot --include pattern (empty = all)')
        string(name: 'ROBOT_EXCLUDE', description: 'Robot --exclude pattern (empty = none)')
    }

    environment {
        FIORI_CREDENTIALS_ID = 'fiori-credentials'
        ROBOT_OUTPUT_DIR     = 'results'
        ROBOT_IMAGE          = 'robot-local:latest'
        PYTHONUNBUFFERED     = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo "Running commit: $(git rev-parse --short HEAD)"'
            }
        }

        stage('Build Robot Image') {
            steps {
                sh '''
                    docker build \
                        --tag "${ROBOT_IMAGE}" \
                        --file Dockerfile.robot \
                        .
                '''
            }
        }

        stage('Run Robot Tests') {
            steps {
                lock('fiori-trial-account') {
                    withCredentials([usernamePassword(
                        credentialsId: env.FIORI_CREDENTIALS_ID,
                        usernameVariable: 'FIORI_USERNAME',
                        passwordVariable: 'FIORI_PASSWORD'
                    )]) {
                        sh '''
                            mkdir -p "${ROBOT_OUTPUT_DIR}"

                            INCLUDE_ARG=""
                            if [ -n "${ROBOT_INCLUDE}" ]; then
                                INCLUDE_ARG="--include ${ROBOT_INCLUDE}"
                            fi

                            EXCLUDE_ARG=""
                            if [ -n "${ROBOT_EXCLUDE}" ]; then
                                EXCLUDE_ARG="--exclude ${ROBOT_EXCLUDE}"
                            fi

                            # Runs inside the robot-local container, in the
                            # checked-out workspace mounted from the Jenkins home.
                            docker run --rm \
                                --shm-size=2g \
                                --volume "${WORKSPACE}:${WORKSPACE}" \
                                --workdir "${WORKSPACE}" \
                                --env FIORI_USERNAME \
                                --env FIORI_PASSWORD \
                                --env BASE_URL="${FIORI_TEST_BASE_URL}" \
                                --env BROWSER="${FIORI_TEST_BROWSER}" \
                                --env HEADLESS="${FIORI_TEST_HEADLESS}" \
                                --env FIORI_LANGUAGE="${FIORI_TEST_LANGUAGE}" \
                                "${ROBOT_IMAGE}" \
                                robot \
                                    --outputdir "${ROBOT_OUTPUT_DIR}" \
                                    --xunit xunit.xml \
                                    ${INCLUDE_ARG} \
                                    ${EXCLUDE_ARG} \
                                    robot-tests/tests/
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            junit testResults: "${ROBOT_OUTPUT_DIR}/xunit.xml",
                  allowEmptyResults: true

            publishHTML(target: [
                allowMissing         : true,
                alwaysLinkToLastBuild: true,
                keepAll              : true,
                reportDir            : env.ROBOT_OUTPUT_DIR,
                reportFiles          : 'report.html',
                reportName           : 'Robot Framework Report'
            ])

            archiveArtifacts artifacts: "${ROBOT_OUTPUT_DIR}/**/*",
                             allowEmptyArchive: true

            cleanWs()
        }
        success {
            echo 'Robot Framework tests passed successfully.'
        }
        failure {
            echo 'Robot Framework tests failed. Check the published reports.'
        }
    }
}
