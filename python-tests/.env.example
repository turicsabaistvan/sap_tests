# Base URL of the Fiori launchpad logon page
BASE_URL=https://account.hanatrial.ondemand.com/

# Browser settings
BROWSER=chromium
HEADLESS=true
BROWSER_LOCALE=en-US

# SAP language code selected in the logon page language drop-down
FIORI_LANGUAGE=EN

# Credentials – never commit real values.
# In CI, these are injected from Jenkins Credentials Store.
FIORI_USERNAME=example@example.com
FIORI_PASSWORD=change-me
