pipeline {
    agent any
    stages {
        stage('Git Pull on VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'win10-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'WIN_USER')]) {
                    sh '''
                        chmod 600 "$SSH_KEY"
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no "${WIN_USER}@${VM_IP}" "cd /d \\"${VM_REPO}\\" && git fetch --all && git pull --ff-only"
                    '''
                }
            }
        }
        stage('Run SAP GUI Robot Test') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'win10-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'WIN_USER')]) {
                    sh '''
                        chmod 600 "$SSH_KEY"
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no "${WIN_USER}@${VM_IP}" "cd /d \\"${VM_REPO}\\" && robot --outputdir results sap_gui_tests/tests"
                    '''
                }
            }
        }
        stage('Collect Report') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'win10-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'WIN_USER')]) {
                    sh '''
                        chmod 600 "$SSH_KEY"
                        mkdir -p robot-results
                        scp -i "$SSH_KEY" -o StrictHostKeyChecking=no "${WIN_USER}@${VM_IP}:${VM_REPO}/sap_gui_tests/results/*.html" "${WIN_USER}@${VM_IP}:${VM_REPO}//results/sap_gui_tests/output.xml" ./robot-results/
                        ls -la ./robot-results
                    '''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'robot-results/**', allowEmptyArchive: false
        }
    }
}