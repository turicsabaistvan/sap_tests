# --- Jenkins ---
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# --- Fiori test account (never commit real values) ---
FIORI_USERNAME=example@example.com
FIORI_PASSWORD=change-me

# --- Test settings ---
BASE_URL=https://account.hanatrial.ondemand.com/
FIORI_LANGUAGE=EN
BROWSER_LOCALE=en-US
BROWSER=chromium
HEADLESS=true

# SAP GUI client used to start a session
SAP_LOGON_EXE=C:\Program Files\SAP\FrontEnd\SAPgui\sapshcut.exe
SAP_GUI_EXE=C:\Program Files\SAP\FrontEnd\SAPgui\sapgui.exe
# SAP system connection
SAP_APP_SERVER=10.0.0.10
SAP_SYS_ID=ABA
SAP_SYS_NUM=00
SAP_CLIENT=800
SAP_USER=YOUR_SAP_USER
SAP_PASS=YOUR_SAP_PASSWORD
SAP_LANG=EN
